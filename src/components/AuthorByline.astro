---
// Named-author byline (compact) and author box (full) for articles.
import type { Author } from '../data/authors';

interface Props {
  author: Author;
  /** 'inline' renders a one-line byline; 'box' renders the footer author card. */
  variant?: 'inline' | 'box';
  reviewedNote?: string;
}

const { author, variant = 'inline', reviewedNote } = Astro.props;
const initials = author.name
  .split(/\s+/)
  .map((part) => part[0])
  .join('')
  .slice(0, 2)
  .toUpperCase();
---

{variant === 'inline' ? (
  <p class="mt-3 flex flex-wrap items-center gap-x-2 text-sm text-slate-600">
    <span>By</span>
    <a href={author.url} rel="author" class="font-medium text-slate-900 hover:text-brand-700 hover:underline">
      {author.name}
    </a>
    <span class="text-slate-400" aria-hidden="true">&middot;</span>
    <span>{author.title}</span>
  </p>
) : (
  <aside class="mt-12 flex gap-4 rounded-2xl border border-slate-200 bg-slate-50 p-5" aria-label="About the author">
    <div
      class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-brand-600 text-lg font-bold text-white"
      aria-hidden="true"
    >
      {initials}
    </div>
    <div class="min-w-0">
      <p class="text-xs font-semibold tracking-wide text-slate-500 uppercase">Written by</p>
      <p class="mt-1 font-semibold text-slate-900">
        <a href={author.url} rel="author" class="hover:text-brand-700 hover:underline">{author.name}</a>
        <span class="font-normal text-slate-500"> &middot; {author.title}</span>
      </p>
      <p class="mt-2 text-sm leading-relaxed text-slate-600">{author.bio}</p>
      {reviewedNote && <p class="mt-2 text-xs text-slate-500">{reviewedNote}</p>}
    </div>
  </aside>
)}
