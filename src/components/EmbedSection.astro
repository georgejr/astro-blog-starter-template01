---
// "Embed this calculator" block. Gives site owners a copy-paste snippet that
// loads the calculator in an iframe (auto-height via /embed.js) and includes
// a visible attribution link back to the calculator page, outside the
// iframe, so the backlink is a normal crawlable link on the host page.
import { SITE_NAME, SITE_URL } from '../lib/site';

interface Props {
  /** Calculator id, e.g. "solar-battery-calculator". */
  id: string;
  /** Human title used in the attribution link text. */
  title: string;
  /** Path of the public calculator page, e.g. "/solar-battery-calculator/". */
  href: string;
}

const { id, title, href } = Astro.props;
const embedUrl = `${SITE_URL}/embed/${id}/`;
const pageUrl = `${SITE_URL}${href}`;

const snippet = [
  `<div class="sunmetriclab-embed" data-calculator="${id}">`,
  `  <iframe src="${embedUrl}" title="${title} by ${SITE_NAME}" loading="lazy" style="width:100%;min-height:720px;border:0;border-radius:12px" allow="clipboard-write"></iframe>`,
  `  <p style="font:14px/1.4 system-ui,sans-serif;margin:8px 0 0;text-align:right">`,
  `    <a href="${pageUrl}" rel="noopener" target="_blank">${title}</a> by <a href="${SITE_URL}/" rel="noopener" target="_blank">${SITE_NAME}</a>`,
  `  </p>`,
  `</div>`,
  `<script src="${SITE_URL}/embed.js" async></script>`,
].join('\n');
---

<section class="mx-auto max-w-3xl rounded-2xl border border-slate-200 bg-white p-6" aria-labelledby="embed-heading">
  <h2 id="embed-heading" class="text-2xl font-bold text-slate-900">Embed this calculator on your site</h2>
  <p class="mt-3 text-sm leading-relaxed text-slate-600">
    Free to use on any website, blog or newsletter page. Paste the snippet below where you want the
    calculator to appear. It is responsive, resizes itself to its content, and includes an
    attribution line linking back to this page (please keep the attribution link visible).
  </p>
  <textarea
    readonly
    rows="8"
    id={`embed-code-${id}`}
    class="mt-4 w-full resize-y rounded-xl border border-slate-300 bg-slate-50 p-3 font-mono text-xs leading-relaxed text-slate-800 focus:border-brand-500 focus:ring-2 focus:ring-brand-200 focus:outline-none"
    aria-label="Embed code"
  >{snippet}</textarea>
  <div class="mt-3 flex flex-wrap items-center gap-3">
    <button
      type="button"
      data-copy-embed={`embed-code-${id}`}
      class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-brand-700"
    >
      Copy embed code
    </button>
    <a href={embedUrl} target="_blank" rel="noopener" class="text-sm text-brand-700 underline">
      Preview the embedded calculator
    </a>
    <span class="text-xs text-slate-500" data-copy-status aria-live="polite"></span>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-embed]').forEach((button) => {
    button.addEventListener('click', async () => {
      const target = document.getElementById(button.dataset.copyEmbed ?? '') as HTMLTextAreaElement | null;
      const status = button.parentElement?.querySelector<HTMLElement>('[data-copy-status]');
      if (!target) return;
      try {
        await navigator.clipboard.writeText(target.value);
        if (status) status.textContent = 'Copied to clipboard.';
      } catch {
        target.select();
        if (status) status.textContent = 'Press Ctrl+C / Cmd+C to copy.';
      }
    });
  });
</script>
