---
// Minimal chrome-free layout for the embeddable calculator widgets served
// under /embed/<calculator>/. No header/footer/analytics, noindex (the
// canonical content lives on the public calculator page), and a small
// script that reports the document height to the host page so the iframe
// can size itself (see public/embed.js).
import { SITE_NAME, SITE_URL } from '../lib/site';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Path of the public calculator page this widget mirrors. */
  canonicalPath: string;
}

const { title, description, canonicalPath } = Astro.props;
const canonicalUrl = new URL(canonicalPath, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | {SITE_NAME} embed</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-white">
    <main id="embed-root" class="p-3 sm:p-4">
      <slot />
      <p class="mt-3 text-right text-xs text-slate-500">
        <a href={canonicalUrl} target="_blank" rel="noopener" class="hover:text-brand-700 hover:underline">{title}</a>
        by
        <a href={`${SITE_URL}/`} target="_blank" rel="noopener" class="font-medium text-slate-700 hover:text-brand-700 hover:underline">{SITE_NAME}</a>
        &middot; free solar calculators
      </p>
    </main>
    <script>
      // Report the rendered height to the embedding page (any origin: the
      // message carries no sensitive data) and re-send on layout changes.
      const root = document.getElementById('embed-root');
      const send = () => {
        const height = root ? root.getBoundingClientRect().height + 8 : document.documentElement.scrollHeight;
        window.parent?.postMessage({ type: 'sunmetriclab:height', height }, '*');
      };
      window.addEventListener('load', send);
      window.addEventListener('resize', send);
      window.addEventListener('message', (event) => {
        if (event.data && event.data.type === 'sunmetriclab:ping') send();
      });
      if (root && 'ResizeObserver' in window) new ResizeObserver(send).observe(root);
      send();
    </script>
  </body>
</html>
