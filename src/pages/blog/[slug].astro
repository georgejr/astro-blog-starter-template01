---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DisclaimerBox from '../../components/DisclaimerBox.astro';
import RelatedArticles from '../../components/RelatedArticles.astro';
import AuthorByline from '../../components/AuthorByline.astro';
import CalculatorCta from '../../components/CalculatorCta.astro';
import { articleSchema, breadcrumbSchema, extractFaqsFromMarkdown, faqSchema } from '../../lib/schema';
import { articlePath, getPrevNext, getPublishedPaths } from '../../lib/content';
import { taxonomySlug } from '../../lib/taxonomy';
import { getAuthor } from '../../data/authors';
import { STATE_SOLAR, getStateBySlug, stateSlug } from '../../data/state-solar';

// Routes are generated for PUBLISHED articles only: a scheduled or draft
// article has no URL in the built site at all (not just noindex).
export async function getStaticPaths() {
  return getPublishedPaths();
}

const { post } = Astro.props;
const { Content } = await render(post);
const { prev, next } = await getPrevNext(post);
const author = getAuthor(post.data.author);

const dateFormat = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const slug = Astro.params.slug!;
const canonicalUrl = new URL(articlePath(post), Astro.site).href;
const ogImage = new URL(`/og/${slug}.png`, Astro.site).href;
const categoryUrl = new URL(`/category/${taxonomySlug(post.data.category)}/`, Astro.site).href;

// State guides ("solar-panels-in-<state>" or a state-name tag) get a
// contextual link to the matching state cost/data page, and vice versa.
const tagNames = post.data.tags.map((t) => t.toLowerCase());
const linkedState =
  getStateBySlug(slug.replace(/^solar-panels-in-/, '')) ??
  STATE_SOLAR.find((s) => tagNames.includes(s.name.toLowerCase()));

const faqs = extractFaqsFromMarkdown(post.body ?? '');
const publishedIso = post.data.publishDate.toISOString();
const modifiedIso = (post.data.updatedDate ?? post.data.publishDate).toISOString();

const structuredData = [
  articleSchema({
    headline: post.data.title,
    description: post.data.description,
    url: canonicalUrl,
    datePublished: publishedIso,
    dateModified: modifiedIso,
    author,
    image: ogImage,
    keywords: [post.data.primaryKeyword, ...post.data.secondaryKeywords],
    articleSection: post.data.category,
  }),
  breadcrumbSchema([
    { name: 'Home', url: new URL('/', Astro.site).href },
    { name: 'Solar Blog', url: new URL('/blog/', Astro.site).href },
    { name: post.data.category, url: categoryUrl },
    { name: post.data.title, url: canonicalUrl },
  ]),
  ...(faqs.length > 0 ? [faqSchema(faqs)] : []),
];

const ctaLead =
  post.data.relatedCalculators.length > 1
    ? 'Put these numbers to work with your own bill:'
    : 'Put these numbers to work with your own bill.';
---

<BaseLayout
  title={`${post.data.title} – Solar Blog`}
  description={post.data.description}
  structuredData={structuredData}
  ogImage={ogImage}
  ogImageAlt={post.data.title}
  ogType="article"
  publishedTime={publishedIso}
  modifiedTime={modifiedIso}
  authorName={author.name}
>
  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <header>
      <nav class="text-sm font-medium text-brand-700" aria-label="Breadcrumb">
        <a href="/blog/" class="hover:underline">&larr; All articles</a>
        <span class="mx-2 text-slate-300">·</span>
        <a href={`/category/${taxonomySlug(post.data.category)}/`} class="hover:underline">
          {post.data.category}
        </a>
      </nav>
      <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">
        {post.data.title}
      </h1>
      <AuthorByline author={author} />
      <p class="mt-1 text-sm text-slate-500">
        <time datetime={publishedIso}>Published {dateFormat.format(post.data.publishDate)}</time>
        {post.data.updatedDate && (
          <span>
            &nbsp;· <time datetime={modifiedIso}>Updated {dateFormat.format(post.data.updatedDate)}</time>
          </span>
        )}
      </p>
    </header>

    <img
      src={`/og/${slug}.png`}
      width="1200"
      height="630"
      alt={post.data.title}
      class="mt-6 aspect-[1200/630] w-full rounded-2xl border border-slate-200 bg-slate-50"
      loading="eager"
    />

    {linkedState && (
      <p class="mt-6 rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-700">
        Looking for the numbers? The
        <a href={`/solar-panel-cost-by-state/${stateSlug(linkedState)}/`} class="font-medium text-brand-700 underline">
          {linkedState.name} solar cost and payback page
        </a>
        has modeled system prices, yearly savings and this state's net metering and incentive notes.
      </p>
    )}

    <div
      class="blog-content mt-8 space-y-5 leading-relaxed text-slate-700
        [&_h2]:mt-10 [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:text-slate-900
        [&_h3]:mt-8 [&_h3]:text-xl [&_h3]:font-semibold [&_h3]:text-slate-900
        [&_a]:text-brand-700 [&_a]:underline
        [&_ul]:list-disc [&_ul]:space-y-1 [&_ul]:pl-5
        [&_ol]:list-decimal [&_ol]:space-y-1 [&_ol]:pl-5
        [&_table]:w-full [&_table]:border-collapse [&_table]:text-sm
        [&_th]:border-b [&_th]:border-slate-300 [&_th]:py-2 [&_th]:pr-4 [&_th]:text-left [&_th]:font-semibold [&_th]:text-slate-900
        [&_td]:border-b [&_td]:border-slate-200 [&_td]:py-2 [&_td]:pr-4
        [&_blockquote]:border-l-4 [&_blockquote]:border-brand-300 [&_blockquote]:pl-4 [&_blockquote]:text-slate-600 [&_blockquote]:italic
        [&_strong]:text-slate-900"
    >
      <Content />
    </div>

    <CalculatorCta ids={post.data.relatedCalculators} lead={ctaLead} limit={2} />

    <AuthorByline
      author={author}
      variant="box"
      reviewedNote={`Checked against the site's modeling assumptions (see the methodology page). Last updated ${dateFormat.format(post.data.updatedDate ?? post.data.publishDate)}.`}
    />

    {post.data.tags.length > 0 && (
      <div class="mt-8 border-t border-slate-200 pt-6">
        <h2 class="text-xs font-semibold tracking-wide text-slate-400 uppercase">Tags</h2>
        <ul class="mt-3 flex flex-wrap gap-2">
          {post.data.tags.map((tag) => (
            <li>
              <a
                href={`/tag/${taxonomySlug(tag)}/`}
                class="inline-block rounded-full border border-slate-200 bg-slate-50 px-3 py-1 text-sm font-medium text-brand-700 hover:border-brand-300 hover:bg-brand-50"
              >
                {tag}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}

    <RelatedArticles post={post} />

    {(prev || next) && (
      <nav class="mt-12 grid gap-4 border-t border-slate-200 pt-8 sm:grid-cols-2" aria-label="Article navigation">
        <div>
          {prev && (
            <a href={articlePath(prev)} class="group block">
              <span class="text-xs font-medium tracking-wide text-slate-400 uppercase">Previous article</span>
              <span class="mt-1 block font-medium text-slate-900 group-hover:text-brand-700">
                {prev.data.title}
              </span>
            </a>
          )}
        </div>
        <div class="sm:text-right">
          {next && (
            <a href={articlePath(next)} class="group block">
              <span class="text-xs font-medium tracking-wide text-slate-400 uppercase">Next article</span>
              <span class="mt-1 block font-medium text-slate-900 group-hover:text-brand-700">
                {next.data.title}
              </span>
            </a>
          )}
        </div>
      </nav>
    )}

    <div class="mt-12">
      <DisclaimerBox />
    </div>
  </article>
</BaseLayout>
